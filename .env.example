# ---------------------------------------------------------------------------
# Copy this file to `.env` and adjust. `.env` is git-ignored.
# ---------------------------------------------------------------------------

# How the phone reaches this machine. Accepts:
#
#   auto                     detect the LAN address at startup (recommended)
#   192.168.1.20             use exactly this address
#   192.168.1.20,10.0.0.5    several; the FIRST is used in QR invitations
#   auto,10.0.0.5            detected address first, then extras
#
# `auto` is recommended: DHCP gives this machine a new address whenever you
# rejoin a network, and a stale address fails silently -- the agent starts, the
# QR renders, and the wallet simply times out with no useful error.
AGENT_HOST_IP=auto

# ACA-Py ports
AGENT_ENDPOINT_PORT=8020
AGENT_ADMIN_PORT=8021

# Django portal
PORTAL_PORT=8000

# Optional software holder agent (agent/run_holder.py). Only used to test the
# flow end-to-end without a phone -- the real demo uses a mobile wallet.
HOLDER_ENDPOINT_PORT=8030
HOLDER_ADMIN_PORT=8031
HOLDER_WALLET_NAME=student_wallet

# ACA-Py admin API key. The portal sends this as the X-API-KEY header.
ACAPY_ADMIN_API_KEY=demo-admin-api-key

# Askar wallet. Change the key for anything beyond a local demo.
WALLET_NAME=university_portal
WALLET_KEY=demo-wallet-key-change-me

# 32-character seed used to derive the issuer's public DID on the ledger.
# Must be exactly 32 characters. Keep it stable so the DID stays the same.
AGENT_SEED=UniversityPortalDemoSeed00000001

# Public Indy test ledger (BCovrin). Hosted -- nothing to run locally.
LEDGER_GENESIS_URL=http://test.bcovrin.vonx.io/genesis
LEDGER_REGISTER_URL=http://test.bcovrin.vonx.io/register

# Django secret key (demo default is fine locally; set your own for anything real)
DJANGO_SECRET_KEY=django-insecure-demo-key-replace-in-production
DJANGO_DEBUG=1

# Local DIDComm mediator for the mobile wallet (agent/run_mediator.py).
# A phone has no public address, so it needs a mediator to receive DIDComm.
# We run our own rather than depend on a public one -- Indicio's public
# mediator WebSocket host no longer resolves in DNS.
MEDIATOR_ENDPOINT_PORT=8040
MEDIATOR_ADMIN_PORT=8041
MEDIATOR_WS_PORT=8042
MEDIATOR_WALLET_NAME=portal_mediator
